# 启明书院后端 —— 环境变量示例（2026-11-20 安全审查修复新增）
#
# 用法：复制为 .env（或直接注入部署环境变量）。**本文件不含任何真实密钥**，
# .env 已在 .gitignore 之外单独提醒：请勿把填充后的 .env 提交到仓库。
#
# 缺省即失败（SecurityStartupValidator / FieldCipher fail-fast）：
#   LUMIN_CURSOR_KEY、LUMIN_CRYPTO_KEY 为空 → 启动直接异常。
# 非开发环境额外要求：
#   LUMIN_ENV != dev/local/test/ci 时，LUMIN_AUTH_MODE 必须为 session。

# ---------- 数据库（必填） ----------
DATABASE_DSN=jdbc:mysql://127.0.0.1:3306/lumin?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DATABASE_USERNAME=
DATABASE_PASSWORD=

# ---------- 部署形态 ----------
# dev = 本地开发（允许 demo 身份头）；production = 生产（禁止 demo、下发 HSTS）
LUMIN_ENV=dev
# HTTPS 部署时置 true，否则不发送 Strict-Transport-Security
LUMIN_HTTPS=false

# ---------- 认证 ----------
# demo = 本地骨架（X-Lumin-Demo-Subject 有界替身）；session = 仅接受 Bearer 会话
LUMIN_AUTH_MODE=demo

# ---------- 密钥（必填，生产经 Secret Manager 注入） ----------
# 游标签名密钥（>=32 字节随机串）
LUMIN_CURSOR_KEY=
# 字段加密密钥（AES-256-GCM，经 SHA-256 派生；>=32 字节随机串）
LUMIN_CRYPTO_KEY=

# ---------- 限流 ----------
# 写方法按主体滑动窗口限流（单实例内存口径；生产建议由网关统一限流）
LUMIN_RATE_LIMIT_ENABLED=false
LUMIN_RATE_LIMIT_WRITES_PER_MINUTE=120
# 免认证入口（注册/登录/二次验证挑战）按客户端 IP 的固定 1 分钟配额（落库计数，多副本一致）
# 反向代理部署必须让网关把真实客户端地址写入 remoteAddr（本服务不信任 X-Forwarded-For）
LUMIN_AUTH_IP_LIMIT_ENABLED=true
# NAT/校园网出口共享同一配额，可按实际调大
LUMIN_AUTH_IP_LIMIT_ATTEMPTS=20

# ---------- CORS（2026-11-20 审查 16 项） ----------
# 逗号分隔的**精确来源**（含协议与端口），不支持通配符 *；留空 = 不注册任何跨源映射
# 前后端分域部署必须填，例：https://www.qiming.example,https://qiming.example
LUMIN_CORS_ALLOWED_ORIGINS=
# 预检结果缓存秒数
LUMIN_CORS_MAX_AGE_SECONDS=3600

# ---------- 口令找回 / 重置（2026-11-20 审查 04 项收尾） ----------
# unconfigured = 只有"明确失败"兜底：邮件通道落 DELIVERY_FAILED 工单转人工客服，
# 不会假装发信成功。smtp = 真实投递（下列参数必须配齐，否则启动失败）
LUMIN_AUTH_RESET_MAIL_MODE=unconfigured
# 例：smtp.example.com / 587（STARTTLS）或 465（SSL）
LUMIN_AUTH_RESET_MAIL_HOST=
LUMIN_AUTH_RESET_MAIL_PORT=587
# 用户名与口令必须同时给或同时留空；带口令而不开加密 → 启动失败（禁止明文发凭据）
LUMIN_AUTH_RESET_MAIL_USERNAME=
LUMIN_AUTH_RESET_MAIL_PASSWORD=
# 发件地址（必须能通过严格邮箱语法校验）
LUMIN_AUTH_RESET_MAIL_FROM=
# STARTTLS 默认开且 required：服务器不支持就失败，不降级明文
LUMIN_AUTH_RESET_MAIL_STARTTLS=true
# 隐式 TLS（SMTPS，通常配合 465）；与 STARTTLS 只能开一个
LUMIN_AUTH_RESET_MAIL_SSL=false
LUMIN_AUTH_RESET_MAIL_TIMEOUT_SECONDS=10

# ---------- 存储 ----------
LUMIN_STORAGE_DIR=

# ---------- AI 供应商（可选） ----------
LUMIN_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:8b
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# ---------- 测试专用（仅本地跑集成测试，勿用于任何部署） ----------
LUMIN_TEST_DB_USERNAME=
LUMIN_TEST_DB_PASSWORD=
# CI/流水线置 true：测试库不可用时直接失败（本地留空 = 允许跳过，报告里记 skipped）
LUMIN_TEST_REQUIRE_DB=false

# ---------- CI 专用（依赖安全扫描，勿放进运行时环境） ----------
# https://nvd.nist.gov/developers/request-an-api-key（缺失会导致扫描极慢）
NVD_API_KEY=
