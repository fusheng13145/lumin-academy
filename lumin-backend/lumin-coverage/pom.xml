<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.leyon</groupId>
        <artifactId>lumin-backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>lumin-coverage</artifactId>
    <name>lumin-coverage</name>
    <description>覆盖率聚合模块（UGC-034/UGC-027）：report-aggregate 收集各模块 exec，
        输出跨模块联合覆盖率报告（无源码、无测试）</description>

    <dependencies>
        <dependency>
            <groupId>com.leyon</groupId>
            <artifactId>lumin-domain</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.leyon</groupId>
            <artifactId>lumin-application</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.leyon</groupId>
            <artifactId>lumin-infrastructure</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.leyon</groupId>
            <artifactId>lumin-ai</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.leyon</groupId>
            <artifactId>lumin-bootstrap</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals><goal>report-aggregate</goal></goals>
                        <configuration>
                            <dataFileIncludes>
                                <dataFileInclude>${java.io.tmpdir}/lumin-jacoco-lumin-bootstrap.exec</dataFileInclude>
                                <dataFileInclude>${java.io.tmpdir}/lumin-jacoco-lumin-application.exec</dataFileInclude>
                                <dataFileInclude>${java.io.tmpdir}/lumin-jacoco-lumin-ai.exec</dataFileInclude>
                            </dataFileIncludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
