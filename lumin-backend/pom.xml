<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.9</version>
        <relativePath/>
    </parent>

    <groupId>com.leyon</groupId>
    <artifactId>lumin-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>启明书院后端</name>
    <description>启明书院后端：模块化单体</description>

    <modules>
        <module>lumin-domain</module>
        <module>lumin-application</module>
        <module>lumin-infrastructure</module>
        <module>lumin-ai</module>
        <module>lumin-bootstrap</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <argLine></argLine>
        <!-- 项目路径含中文时 JaCoCo agent 写 target 会静默失败：执行数据统一落 ASCII 临时目录。 -->
        <jacoco.exec.path>${java.io.tmpdir}/lumin-jacoco-${project.artifactId}.exec</jacoco.exec.path>
        <!-- OWASP dependency-check 版本（可用 -Ddependency-check.version 覆盖） -->
        <dependency-check.version>12.1.0</dependency-check.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <argLine>@{argLine}</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.15</version>
                        <executions>
                            <execution>
                                <id>prepare-agent</id>
                                <configuration>
                                    <destFile>${jacoco.exec.path}</destFile>
                                </configuration>
                                <goals><goal>prepare-agent</goal></goals>
                            </execution>
                            <execution>
                                <id>report</id>
                                <phase>verify</phase>
                                <configuration>
                                    <dataFile>${jacoco.exec.path}</dataFile>
                                </configuration>
                                <goals><goal>report</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- ============================================================
             依赖安全扫描（2026-11-20 安全审查 17 项；CI 专用，不参与日常构建）
             用法：mvn -Psecurity-scan org.owasp:dependency-check-maven:check
             环境变量 NVD_API_KEY（https://nvd.nist.gov/developers/request-an-api-key）
             缺失时 NVD 会限流（极慢），故 CI 仅在提供密钥时执行该 job。
             失败阈值 failBuildOnCVSS=7（HIGH/CRITICAL 即拦），报告落 target/。
             ============================================================ -->
        <profile>
            <id>security-scan</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>${dependency-check.version}</version>
                        <configuration>
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                            <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                            </formats>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
